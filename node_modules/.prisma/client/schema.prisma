// CoalGov Prisma Schema
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MINE_OFFICIAL
  INSPECTOR
  MANAGER
  REGULATOR
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String
  name         String
  role         Role     @default(MINE_OFFICIAL)
  phone        String?
  mineName     String? // Associated mine/block name if applicable
  designation  String? // Official designation / title
  refreshToken String?  @db.Text
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}
