// CoalGov Prisma Schema
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MINE_OFFICIAL
  INSPECTOR
  MANAGER
  REGULATOR
}

enum ComplianceCategory {
  SAFETY
  ENVIRONMENT
  PRODUCTION
  LABOUR
}

enum ComplianceStatus {
  COMPLIANT
  NON_COMPLIANT
  UNDER_REVIEW
  EXPIRED
}

enum InspectionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  FLAGGED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ViolationStatus {
  REPORTED
  ACTION_ASSIGNED
  RECTIFIED
  VERIFIED
  CLOSED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String
  name         String
  role         Role     @default(MINE_OFFICIAL)
  phone        String?
  mineName     String?  // Associated mine/block name if applicable
  designation  String?  // Official designation / title
  refreshToken String?  @db.Text
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  inspections      Inspection[]      @relation("InspectorInspections")
  violations       Violation[]       @relation("ReportedViolations")
  actionsAssigned  CorrectiveAction[] @relation("AssignedActions")
  auditLogs        AuditLog[]

  @@map("users")
}

model Mine {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. MINE-JH-001
  name        String
  subsidiary  String   // e.g. ECL, BCCL, CCL, WCL, SECL, MCL, NCL
  state       String
  district    String
  latitude    Float?
  longitude   Float?
  operationalStatus String @default("ACTIVE") // ACTIVE, SUSPENDED, CLOSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inspections Inspection[]
  compliances StatutoryCompliance[]

  @@map("mines")
}

model StatutoryCompliance {
  id          String             @id @default(uuid())
  mineId      String
  title       String
  category    ComplianceCategory
  status      ComplianceStatus   @default(UNDER_REVIEW)
  validUntil  DateTime?
  documentUrl String?            // PDF Clearance / Statutory Certificate
  remarks     String?            // Written remarks / regulatory conditions
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  mine        Mine               @relation(fields: [mineId], references: [id], onDelete: Cascade)

  @@map("statutory_compliances")
}

model Inspection {
  id            String           @id @default(uuid())
  mineId        String
  inspectorId   String
  title         String
  status        InspectionStatus @default(SCHEDULED)
  scheduledDate DateTime
  completedDate DateTime?
  latitude      Float?           // Geo-tagging
  longitude     Float?           // Geo-tagging
  reportUrl     String?          // Official Inspection Report PDF from Authority
  notes         String?          // Written observations / notes
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  mine          Mine             @relation(fields: [mineId], references: [id], onDelete: Cascade)
  inspector     User             @relation("InspectorInspections", fields: [inspectorId], references: [id])
  violations    Violation[]

  @@map("inspections")
}

model Violation {
  id           String          @id @default(uuid())
  inspectionId String
  reporterId   String
  title        String
  description  String          // Written description of the violation
  severity     Severity        @default(MEDIUM)
  status       ViolationStatus @default(REPORTED)
  category     ComplianceCategory
  deadline     DateTime?
  noticePdfUrl String?         // Official Violation / Show-Cause Notice PDF from Authority
  imageUrl     String?         // Photo / Image evidence
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  inspection   Inspection      @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  reporter     User            @relation("ReportedViolations", fields: [reporterId], references: [id])
  actions      CorrectiveAction[]

  @@map("violations")
}

model CorrectiveAction {
  id             String    @id @default(uuid())
  violationId    String
  assigneeId     String
  actionPlan     String    // Action plan details
  responseText   String?   // Mine official's written response / justification
  responsePdfUrl String?   // Mine official's formal counter / compliance response PDF
  evidenceUrl    String?   // Evidence PDF or photo proving rectification
  status         String    @default("PENDING") // PENDING, IN_PROGRESS, RESOLVED, VERIFIED
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  violation      Violation @relation(fields: [violationId], references: [id], onDelete: Cascade)
  assignee       User      @relation("AssignedActions", fields: [assigneeId], references: [id])

  @@map("corrective_actions")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String   // e.g. "USER_LOGIN", "INSPECTION_REPORT_UPLOADED", "MINE_RESPONSE_SUBMITTED"
  entity    String   // e.g. "User", "Inspection", "Violation", "CorrectiveAction"
  entityId  String?
  metadata  Json?
  timestamp DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
